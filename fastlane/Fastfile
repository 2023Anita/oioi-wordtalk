require "base64"

default_platform(:ios)

PROJECT = "ios/App/App.xcodeproj"
SCHEME = "App"
BUNDLE_ID = "com.oioiacademy.wordtalk"
PROFILE_NAME = "OiOi WordTalk AppStore"

platform :ios do
  desc "Build the Capacitor app and upload it to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: ENV["ASC_KEY_P8"].to_s.include?("BEGIN PRIVATE KEY") ? false : true,
      in_house: false
    )

    use_match = ENV["MATCH_GIT_URL"].to_s != ""
    use_manual = !use_match && ENV["IOS_DIST_P12"].to_s != "" && ENV["IOS_APPSTORE_PROFILE"].to_s != ""
    if use_manual
      # Distribution certificate + App Store profile stored as repo secrets (no device needed).
      p12_path = File.expand_path("../dist.p12", __dir__)
      File.binwrite(p12_path, Base64.decode64(ENV["IOS_DIST_P12"]))
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["IOS_DIST_P12_PASSWORD"].to_s,
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
      profile_path = File.expand_path("../appstore.mobileprovision", __dir__)
      File.binwrite(profile_path, Base64.decode64(ENV["IOS_APPSTORE_PROFILE"]))
      install_provisioning_profile(path: profile_path)
      update_code_signing_settings(
        use_automatic_signing: false,
        path: PROJECT,
        targets: ["App"],
        team_id: ENV["APPLE_TEAM_ID"],
        bundle_identifier: BUNDLE_ID,
        profile_name: PROFILE_NAME,
        code_sign_identity: "Apple Distribution"
      )
    end
    if use_match
      match(type: "appstore", readonly: true, api_key: api_key)
      update_code_signing_settings(
        use_automatic_signing: false,
        path: PROJECT,
        bundle_identifier: BUNDLE_ID,
        profile_name: "match AppStore #{BUNDLE_ID}",
        code_sign_identity: "Apple Distribution"
      )
    end

    latest = latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID, initial_build_number: 0)
    increment_build_number(xcodeproj: PROJECT, build_number: latest + 1)

    key_path = File.expand_path("../asc_key.p8", __dir__)
    raw = ENV["ASC_KEY_P8"].to_s
    File.write(key_path, raw.include?("BEGIN PRIVATE KEY") ? raw : Base64.decode64(raw))

    team = ENV["APPLE_TEAM_ID"].to_s
    team_arg = team.empty? ? "" : " DEVELOPMENT_TEAM=#{team}"

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      export_method: "app-store",
      clean: true,
      export_options: use_manual ? { method: "app-store", signingStyle: "manual", provisioningProfiles: { BUNDLE_ID => PROFILE_NAME } } : nil,
      xcargs: ((use_match || use_manual) ? "" : "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}") + team_arg,
      export_xcargs: (use_match || use_manual) ? nil : "-allowProvisioningUpdates -authenticationKeyPath #{key_path} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    )

    upload_to_testflight(
      api_key: api_key,
      changelog: ENV["CHANGELOG"] || "OiOi WordTalk beta",
      skip_waiting_for_build_processing: true
    )
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
    [p12_path, profile_path].each { |f| File.delete(f) if f && File.exist?(f) }
  end
end
